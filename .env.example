# Copy to .env and fill in with your Supabase project's values
# (Project Settings -> API in the Supabase Dashboard).

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Same values, exposed to the Vite client bundle -- required, Vite only
# inlines env vars prefixed VITE_.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Public half of the VAPID keypair generated by the backend repo's setup.sh
# (VAPID_PUBLIC_KEY there). Must match the private key the backend uses to
# sign pushes, or subscriptions silently fail.
VITE_VAPID_PUBLIC_KEY=

# Optional: YYYY-MM-DD. Net worth "change since" is measured from the first snapshot on or
# after this day. Use it if your earliest snapshots were incomplete (e.g. before you added
# investments) and the percentage looks absurd.
VITE_NET_WORTH_START=
