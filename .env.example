# Copy to .env and fill in with your Supabase project's values
# (Project Settings -> API in the Supabase Dashboard).

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Same values, exposed to the Vite client bundle -- required, Vite only
# inlines env vars prefixed VITE_.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
